# Copy this file to .env and fill in your values. Never commit the real .env.

# Your bot's token, from https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=

# Your bot's Application (Client) ID, from the "General Information" page
CLIENT_ID=

# The server (guild) ID you're deploying commands/reminders to.
# Right-click your server icon in Discord (with Developer Mode on) -> Copy Server ID
GUILD_ID=

# The channel ID where assignment reminders should be posted.
# Right-click the channel -> Copy Channel ID
REMINDER_CHANNEL_ID=

# Cron schedule for the daily reminder check (default: 8:00 AM every day)
# Format: minute hour day month weekday
REMINDER_CRON=0 8 * * *

# How many days out counts as "upcoming" for daily pings (default 3)
REMINDER_WINDOW_DAYS=3

# --- Canvas LMS integration (optional but recommended) ---

# Your Canvas instance's base URL, no trailing slash, e.g.:
# https://yourschool.instructure.com
CANVAS_BASE_URL=

# Generate at: Canvas -> Account (left sidebar) -> Settings -> "+ New Access Token"
# Treat this like a password. Keep it only in this local .env file, never commit it,
# and revoke it from that same Settings page if it's ever exposed.
CANVAS_API_TOKEN=

# Optional: comma-separated Canvas course IDs to limit syncing to specific
# courses. Leave blank to sync all of your active courses.
# Find a course ID in its Canvas URL: .../courses/12345
CANVAS_COURSE_IDS=

# How often to pull new/updated assignments from Canvas (default: every 30 min)
CANVAS_SYNC_CRON=*/30 * * * *
